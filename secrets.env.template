#!/usr/bin/env bash
# shellcheck shell=bash disable=SC2034
#
# secrets.env.template -- copy to secrets.env and edit.
#
#   cp secrets.env.template secrets.env
#   nano secrets.env
#
# secrets.env is gitignored. It is NOT part of a git clone and NOT part of
# et-user-backup, so keep a copy off-machine.
#
# WHAT IS *NOT* HERE, AND WHY
#
# Only settings with a real decision behind them belong in this file. These are
# computed, derived, or build-tooling details, and are hardcoded in the scripts:
#
#   APRS passcode         computed from CALLSIGN       lib/common.sh
#   APRS lat/lon          derived from GRID_SQUARE     lib/common.sh
#   Desktop / display     hardcoded to match ETC R7    customize_desktop()
#   squashfs compression  hardcoded to zstd            rebuild_squashfs()
#   nodejs / npm          hardcoded build deps         customize_additional_packages()
#   D890 Bluetooth MAC    discovered by `et-anytone-d890 pair`
#
# SECURITY: build-etc-iso.sh copies this file into the ISO at
# /opt/emcomm-customizer-cache/secrets.env so the installed system can rebuild
# itself. That means a normal ISO contains your WiFi PSKs and Winlink
# password. Don't share it. Build with -m for an ISO without the cache.

# ---------------------------------------------------------------------------
# Operator identity                                               [REQUIRED]
# ---------------------------------------------------------------------------
CALLSIGN="N0CALL"
GRID_SQUARE="CN87uo"                    # 4 or 6 character Maidenhead grid
WINLINK_PASSWORD=""                     # Your Winlink account password

# ---------------------------------------------------------------------------
# Machine identity
# ---------------------------------------------------------------------------
MACHINE_NAME="ETC-N0CALL"
TIMEZONE="America/Denver"               # e.g. America/Los_Angeles, UTC
LOCALE="en_US.UTF-8"
KEYBOARD_LAYOUT="us"

# ---------------------------------------------------------------------------
# User account
# ---------------------------------------------------------------------------
# There is no autoinstall or preseed -- you create your account in the normal
# Ubuntu installer. These values only affect the live session and /etc/skel,
# so USER_USERNAME must match the account you intend to create, or the
# skel-seeded ETC config lands in the wrong home directory.
USER_USERNAME="emcomm"
USER_FULLNAME="EmComm Operator"
USER_EMAIL="you@example.com"
USER_PASSWORD=""                        # Live session only

# Recommended "no". Autologin targets USER_USERNAME; if that account does not
# exist on the installed system, you get a login loop.
ENABLE_AUTOLOGIN="no"

# ---------------------------------------------------------------------------
# WiFi
# ---------------------------------------------------------------------------
# Add as many networks as you like: WIFI_SSID_<NAME>, WIFI_PASSWORD_<NAME>,
# WIFI_AUTOCONNECT_<NAME>. customize_wifi() finds them by scanning this file
# for WIFI_SSID_*, so adding a network needs no code change. <NAME> may contain
# A-Z, 0-9 and underscores. A network with an empty SSID or password is skipped.
WIFI_SSID_HOME=""
WIFI_PASSWORD_HOME=""
WIFI_AUTOCONNECT_HOME="yes"

WIFI_SSID_MOBILE=""
WIFI_PASSWORD_MOBILE=""
WIFI_AUTOCONNECT_MOBILE="no"

# ---------------------------------------------------------------------------
# Radio -- AnyTone AT-D578UVIII CAT control
# ---------------------------------------------------------------------------
# Writes one profile: Hamlib model 37001 (RIG_MODEL_ATD578UVIII) at 115200
# baud, commode=1, ptt=RIG. That gives get/set frequency, VFO A/B, clock and
# PTT. While rigctld holds the port the radio shows EXTERNAL CABLE MODE and
# its front panel locks out.
#
# Caveats worth knowing before you debug set_freq:
#   - set_freq only works with Channel A selected AND VFO A in VFO mode.
#   - If VFO A is in MR (memory) mode the radio refuses frequency changes.
#   - If VFO B is selected, get_freq returns VFO A and set_freq is refused.
#   - PTT works regardless, on whichever VFO is selected.
#
# If you want PTT only, with the front panel left usable, do NOT look for an
# option here -- select "DigiRig Mobile (No CAT)" in et-radio. That is stock
# ETC, it keys the radio over the DigiRig's serial RTS line using Hamlib model
# 6 (RIG_MODEL_DUMMY_NOVFO), and it needs no custom Hamlib at all. A commode=0
# profile used to be written here and was removed in v2.1.0 as a duplicate of
# exactly that.
#
# Assumes the AT-D578 DigiRig cable (CAT-control variant) into the radio's
# RJ-45 mic jack. Stock udev rules already provide /dev/et-cat and /dev/et-audio.
ENABLE_ANYTONE_D578="yes"

# Builds CowboyPilot/Hamlib into the ISO, which is what provides model 37001.
#
# Leave this "yes". Until v2.1.0 the ISO build never installed this backend, so
# every ISO shipped a D578UVIII profile pinned to a Hamlib model the bundled
# Hamlib 4.5 had never heard of -- rigctld rejected it and there was no CAT and
# no PTT on a fresh install. Setting it "no" reproduces that, and the build will
# warn you. Adds roughly 10 minutes to the build.
ENABLE_HAMLIB_ANYTONE="yes"

# ---------------------------------------------------------------------------
# Radio -- AnyTone AT-D890UV Bluetooth KISS TNC
# ---------------------------------------------------------------------------
# The D890UV is a DMR handheld: packet runs over its built-in Bluetooth KISS
# TNC, not a serial CAT port. This writes an anytone-d890.bt.json profile and
# an et-anytone-d890 helper (pair / connect / unpair), following the same
# pattern as ETC's own et-uv-pro and et-th-d74.
#
# Run `et-anytone-d890 pair` once on the installed system -- it discovers the
# radio's MAC and writes it into the profile, so there is no MAC setting here.
#
# Radio firmware 1.05 (May 2026) or newer is strongly recommended; earlier
# firmware has known Bluetooth KISS TNC and APRS beacon defects.
ENABLE_ANYTONE_D890_TNC="yes"

# ---------------------------------------------------------------------------
# APRS
# ---------------------------------------------------------------------------
ENABLE_APRS_BEACON="yes"
ENABLE_APRS_IGATE="no"                  # yes = also gate RF to APRS-IS

APRS_SSID="-10"                         # -10 is conventional for a gateway
APRS_SYMBOL="/-"                        # "/-" = house, "/b" = bicycle, "/>" = car
APRS_COMMENT="EmComm Tools Community"
APRS_BEACON_MODE="gps"                  # gps = beacon GPS position; fixed = use grid
APRS_BEACON_INTERVAL="30"               # Minutes between beacons
APRS_BEACON_VIA="WIDE1-1,WIDE2-1"       # Digipeater path
APRS_BEACON_POWER="50"                  # Watts, for the PHG field
APRS_BEACON_HEIGHT="20"                 # Feet above average terrain
APRS_BEACON_GAIN="3"                    # Antenna gain in dB
APRS_SERVER="noam.aprs2.net"            # APRS-IS server, iGate only

# ---------------------------------------------------------------------------
# Applications baked into the ISO
# ---------------------------------------------------------------------------
# Installed at BUILD time inside the chroot, so they work offline on first
# boot and a failure fails the build instead of surfacing in the field.

# Ubuntu 22.10 has NO 'code' package and the build removes the Microsoft apt
# repos, so a .deb is the only route. Leave VSCODE_DEB empty to download the
# current stable build.
ENABLE_VSCODE="yes"
VSCODE_DEB=""                           # e.g. /home/you/Downloads/code_*_amd64.deb

# CHIRP, built from the official git repo into /opt/chirp-venv.
#
# Not from PyPI: `pip install chirp` installs an unrelated 2013 package for
#   analyzing bioacoustic recordings. Three code paths here used to do exactly
#   that, which is why CHIRP was never actually present before v2.1.0.
# Not from archive.chirpmyradio.com: it serves HTTP 403 to non-browsers.
# Not from apt: kinetic ships CHIRP 20200227, six years stale.
#
# Pin CHIRP_GIT_REF to a commit for reproducible builds, or "master" for latest.
ENABLE_CHIRP="yes"
CHIRP_GIT_REF="master"

# anytone-cps (github.com/xbenkozx/anytone-cps)
#
# Open-source CPS for AnyTone DMR radios. CHIRP does not support AnyTone DMR
# radios at all, so without this there is no Linux path to program the
# D578UVIII or D890UV. Alpha upstream (D878UVII tested, D890UV listed but
# untested), so a failure here warns and continues rather than failing the ISO.
ENABLE_ANYTONE_CPS="yes"

# GitHub CLI, from the official .deb. kinetic's apt version is gh 2.14.4 from
# mid-2022, which is old for a tool whose whole job is a remote API -- but apt
# is the automatic fallback if the download fails, so an offline build still
# gets a working gh.
#
# This is also the fix for git credentials ON THE INSTALLED SYSTEM. Run:
#   gh auth login && gh auth setup-git
# and gh registers itself as git's credential helper, so `git push` works from
# a plain terminal. Deliberately not done at build time -- that would bake a
# personal token into the image.
ENABLE_GH_CLI="yes"
GH_CLI_VERSION="2.105.0"

# ---------------------------------------------------------------------------
# Power
# ---------------------------------------------------------------------------
# IDLE behaviour. These are GNOME enums and timeouts, not percentages:
#   *_IDLE_*       nothing | suspend | hibernate
#   *_LID_CLOSE_*  nothing | suspend | hibernate | logout
#   POWER_BUTTON   nothing | suspend | hibernate | interactive
#
# AUTOMATIC_SUSPEND="no" additionally forces both sleep-inactive types to
# 'nothing' -- a timeout alone does not prevent suspend.
AUTOMATIC_SUSPEND="no"
AUTOMATIC_POWER_SAVER="no"
POWER_IDLE_AC="nothing"
POWER_IDLE_BATTERY="nothing"
POWER_IDLE_TIMEOUT="0"                  # Seconds; 0 = never
POWER_LID_CLOSE_AC="suspend"
POWER_LID_CLOSE_BATTERY="suspend"
POWER_BUTTON_ACTION="interactive"

# BATTERY CHARGE behaviour. This is UPower's job, not GNOME's -- there is no
# dconf key anywhere that accepts a percentage, so do not try to put one in
# POWER_IDLE_BATTERY. Written to /etc/UPower/UPower.conf.
#   POWER_BATTERY_ACTION: PowerOff | Hibernate | HybridSleep | Suspend | Ignore
POWER_BATTERY_ACTION_PERCENT="10"       # Act at this charge level, 1-100
POWER_BATTERY_ACTION="Suspend"

# NOTE: POWER_MODE was removed in v2.1.0. The GNOME power profile is owned by
# power-profiles-daemon over D-Bus and is not a dconf key, so the setting never
# had any effect. Use `powerprofilesctl set performance` on the running system.

# ---------------------------------------------------------------------------
# Offline maps
# ---------------------------------------------------------------------------
# BOTH must be set. If either is empty the ETC installer stops on an
# interactive dialog partway through the chroot build and waits for a human.
OSM_MAP_STATE="washington"              # Lowercase US state, for Navit routing
ET_MAP_REGION="us"                      # us | ca | world, pre-rendered tiles

# The tilesets are fetched from ETC's R5 release. That is correct and
# intentional -- R7 ships no release assets, so R5 is still where they live.

# ---------------------------------------------------------------------------
# Offline Wikipedia (optional, large)
# ---------------------------------------------------------------------------
# ET_EXPERT is what makes the ETC installer offer the Wikipedia download at
# all. Leave both unset unless you want it; set WIKIPEDIA_SECTIONS too, or the
# build stops on a dialog.
#   ET_EXPERT="1"
#   WIKIPEDIA_SECTIONS="medicine,survival"

# ---------------------------------------------------------------------------
# Pat Winlink
# ---------------------------------------------------------------------------
PAT_EMCOMM_ALIAS="emcomm"               # `pat connect emcomm`
# PAT_EMCOMM_GATEWAY=""                 # Optional explicit RMS gateway

# ---------------------------------------------------------------------------
# et-os-addons (github.com/clifjones/et-os-addons)
# ---------------------------------------------------------------------------
# Third-party extras. Most of these install only a LAUNCHER -- the application
# itself is a separate install. The defaults below are "no" for everything
# whose target app ETC does not provide, because a menu entry that errors on
# click is worse than no menu entry.

# Works immediately, nothing else needed:
ENABLE_ETOSADDONS_HOTSPOT="yes"         # WiFi hotspot, an nmcli wrapper

# Replaces ETC's own et-user-backup with a BACKUP_ITEMS.lst manifest, which
# changes what actually gets backed up. Opt-in, and worth reading first if you
# depend on the stock backup contents.
ENABLE_ETOSADDONS_USERBACKUP="yes"

# --- Off: ETC already provides this ---
# Kiwix has shipped natively since R4, and R7 adds et-index on top. This flag
# only adds a second, duplicate launcher.
ENABLE_ETOSADDONS_KIWIX="no"

# Stock ETC already ships vgc-vrn76.bt.json and et-vr-n76. This is the legacy
# utility, superseded upstream.
ENABLE_ETOSADDONS_VR_N76="no"

# --- Off: Wine launcher, but you must install the .exe yourself ---
# Each needs its application inside ETC's 32-bit Wine prefix (~/.wine32). The
# launcher appears in the menu and fails until the .exe is there.
ENABLE_ETOSADDONS_NETCONTROL="no"       # needs drive_c/netcontrol/NetControl.exe
ENABLE_ETOSADDONS_VARAC="no"            # needs drive_c/VarAC/VarAC.exe
ENABLE_ETOSADDONS_VARA_EXTRAS="no"      # VARA Chat / SAT / Terminal launchers

# --- Off: launcher for an app ETC does not install at all ---
ENABLE_ETOSADDONS_QSSTV="no"            # needs /usr/local/bin/qsstv
ENABLE_ETOSADDONS_JS8SPOTTER="no"       # needs ~/apps/js8spotter
ENABLE_ETOSADDONS_COMMSTATONE="no"      # needs CommStatOne under ~/apps

# NOTE: ENABLE_ETOSADDONS_WSJTX was removed in v2.0.0. There is no et-wsjtx in
# the et-os-addons repo and ETC already ships /opt/emcomm-tools/bin/et-wsjtx,
# so setting it never did anything.
